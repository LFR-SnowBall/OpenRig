cmd_snapshot() {
    local sub="${1:-list}"
    shift || true
    case "$sub" in
        save|create)
            local tag="${1:?Usage: ./rig snapshot save <snapshot-name>}"
            echo -e "${CYAN}📸 Saving workstation snapshot as 'openrig-snapshot:${tag}'...${RESET}"
            docker commit openrig "openrig-snapshot:${tag}" >/dev/null
            echo -e "${GREEN}✅ Snapshot 'openrig-snapshot:${tag}' saved successfully.${RESET}"
            ;;
        list|ls)
            echo -e "${CYAN}📸 Available Snapshots (Time Machine):${RESET}"
            docker images "openrig-snapshot" --format "table {{.Repository}}:{{.Tag}}\t{{.CreatedSince}}\t{{.Size}}"
            ;;
        restore)
            local tag="${1:?Usage: ./rig snapshot restore <snapshot-name>}"
            ensure_env
            local role
            role=$(grep -E '^OPENRIG_ROLE=' "$ENV_FILE" | cut -d= -f2 || echo "fullstack")
            echo -e "${YELLOW}⏪ Restoring OpenRig workstation to snapshot 'openrig-snapshot:${tag}'...${RESET}"
            docker tag "openrig-snapshot:${tag}" "openrig:${role}"
            docker compose -f "${RIG_DIR}/docker-compose.yml" --env-file "$ENV_FILE" up -d --force-recreate
            echo -e "${GREEN}✅ Workstation restored to '${tag}'.${RESET}"
            ;;
        export)
            local tag="${1:?Usage: ./rig snapshot export <snapshot-name> [output.tar.gz]}"
            local out="${2:-openrig-${tag}.tar.gz}"
            echo -e "${CYAN}📦 Exporting snapshot '${tag}' to ${out}...${RESET}"
            docker save "openrig-snapshot:${tag}" | gzip > "$out"
            echo -e "${GREEN}✅ Exported to: ${out}${RESET}"
            ;;
        import)
            local file="${1:?Usage: ./rig snapshot import <file.tar.gz> [snapshot-name]}"
            echo -e "${CYAN}📥 Importing snapshot from ${file}...${RESET}"
            gunzip -c "$file" | docker load
            echo -e "${GREEN}✅ Snapshot imported.${RESET}"
            ;;
        *)
            echo "📸 OpenRig Time Machine (rig snapshot):"
            echo "  ./rig snapshot save <tag>              -> Freeze current workstation state"
            echo "  ./rig snapshot list                    -> List saved snapshots"
            echo "  ./rig snapshot restore <tag>           -> Roll back workstation to a snapshot"
            echo "  ./rig snapshot export <tag> [file.tgz] -> Export snapshot to portable .tar.gz"
            echo "  ./rig snapshot import <file.tgz>       -> Import a portable snapshot"
            ;;
    esac
}

get_hardware_id() {
    local raw=""
    if command -v ioreg >/dev/null 2>&1; then
        raw=$(ioreg -rd1 -c IOPlatformExpertDevice | awk -F\" '/IOPlatformUUID/{print $4}')
    elif [ -f /etc/machine-id ]; then
        raw=$(cat /etc/machine-id)
    else
        raw="$(hostname)-$(uname -m)"
    fi
    printf "%s" "$raw" | shasum -a 256 | awk '{print $1}'
}

cmd_device() {
    docker exec $TTY_FLAG openrig rig-device "$@"
}

cmd_join() {
    local server="${1:?Usage: rig join <server:7070> --token <rig_inv_...>}"
    shift || true
    local token=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --token|-t) token="$2"; shift 2 ;;
            *) token="$1"; shift ;;
        esac
    done
    if [ -z "$token" ]; then
        echo -e "${RED}❌ Missing invitation token (--token rig_inv_...).${RESET}"
        exit 1
    fi

    local hw_id
    hw_id=$(get_hardware_id)
    local dev_name
    dev_name=$(hostname -s 2>/dev/null || hostname)
    local key_dir="$HOME/.openrig"
    mkdir -p "$key_dir"
    chmod 700 "$key_dir"
    local key_file="$key_dir/device_ed25519"
    local askpass_file="$key_dir/hw-askpass.sh"

    cat << 'ASKPASS' > "$askpass_file"
#!/usr/bin/env bash
if [[ "$OSTYPE" == "darwin"* ]]; then
    raw=$(ioreg -rd1 -c IOPlatformExpertDevice | awk -F'"' '/IOPlatformUUID/{print $4}')
elif [ -f /sys/class/dmi/id/product_uuid ]; then
    raw=$(cat /sys/class/dmi/id/product_uuid 2>/dev/null || cat /etc/machine-id)
elif [ -f /etc/machine-id ]; then
    raw=$(cat /etc/machine-id)
else
    raw="$(hostname)-$(uname -m)"
fi
printf "%s" "$raw" | shasum -a 256 | awk '{print $1}'
ASKPASS
    chmod 700 "$askpass_file"

    # Regenerate hardware-encrypted key so it cannot be decrypted on any other motherboard
    rm -f "$key_file" "${key_file}.pub"
    ssh-keygen -t ed25519 -f "$key_file" -N "$hw_id" -C "openrig-bound-${dev_name}" >/dev/null
    local pubkey
    pubkey=$(cat "${key_file}.pub")

    echo -e "${CYAN}🔐 Binding this machine (${dev_name} | RAM-derived HW-ID) to OpenRig-Server (${server})...${RESET}"
    local resp
    resp=$(curl -sS -X POST "http://${server}/enroll" \
        -H "Content-Type: application/json" \
        -d "{\"token\":\"${token}\",\"public_key\":\"${pubkey}\",\"hardware_id\":\"${hw_id}\",\"device_name\":\"${dev_name}\"}")

    if ! echo "$resp" | grep -q '"status": *"enrolled"'; then
        echo -e "${RED}❌ Device enrollment failed: ${resp}${RESET}"
        exit 1
    fi

    local user ssh_port kc_secret kc_uri
    user=$(echo "$resp" | python3 -c "import sys,json; print(json.load(sys.stdin)['username'])")
    ssh_port=$(echo "$resp" | python3 -c "import sys,json; print(json.load(sys.stdin)['ssh_port'])")
    kc_secret=$(echo "$resp" | python3 -c "import sys,json; print(json.load(sys.stdin)['keychain_secret'])")
    kc_uri=$(echo "$resp" | python3 -c "import sys,json; print(json.load(sys.stdin)['keychain_uri'])")
    local host_ip="${server%:*}"

    mkdir -p "$HOME/.ssh"
    touch "$HOME/.ssh/config"
    # Remove previous entry for openrig-${user} if exists
    python3 - "$HOME/.ssh/config" "openrig-${user}" << 'PY'
import re, sys
p, alias = sys.argv[1], sys.argv[2]
txt = open(p).read()
txt = re.sub(rf"\nHost {re.escape(alias)}\n(?:    .*\n)*", "\n", txt)
open(p, "w").write(txt)
PY

    cat << EOF >> "$HOME/.ssh/config"

Host openrig-${user}
    HostName ${host_ip}
    Port ${ssh_port}
    User rig
    IdentityFile ${key_file}
    IdentitiesOnly yes
    StrictHostKeyChecking accept-new
    LocalForward 3000 127.0.0.1:3000
    LocalForward 5173 127.0.0.1:5173
    LocalForward 8000 127.0.0.1:8000
    LocalForward 8080 127.0.0.1:8080
EOF

    echo -e "${GREEN}✅ Device '${dev_name}' successfully enrolled and previous devices unlinked!${RESET}"
    echo -e "   • Private key encrypted with this motherboard's hardware UUID (unusable if copied to another PC)."
    echo -e "   • Connect in 1 second with: ${BOLD}rig connect openrig-${user}${RESET}"
    echo -e "   • Keychain TOTP (for Guest Mode 'rig guest' on another PC): ${YELLOW}${kc_secret}${RESET}"
    echo -e "   • 1Password / Authenticator URI: ${kc_uri}"
}

cmd_guest() {
    local server="${1:?Usage: rig guest <server:7070> --user <username> [--code <6-digit-totp>]}"
    shift || true
    local user=""
    local code=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --user|-u) user="$2"; shift 2 ;;
            --code|-c) code="$2"; shift 2 ;;
            *) [ -z "$user" ] && user="$1"; shift ;;
        esac
    done

    if [ -z "$user" ]; then
        read -r -p "👤 Username on OpenRig-Server: " user
    fi
    if [ -z "$code" ]; then
        read -r -p "🔐 6-digit code from your Keychain (1Password / Authenticator): " code
    fi

    local tmp_dir
    tmp_dir=$(mktemp -d /tmp/rig-guest-XXXXXX)
    trap 'rm -rf "$tmp_dir"' EXIT INT TERM

    ssh-keygen -t ed25519 -f "${tmp_dir}/guest_key" -N "" -C "guest-ephemeral" >/dev/null
    local pubkey
    pubkey=$(cat "${tmp_dir}/guest_key.pub")

    echo -e "${CYAN}🔑 Verifying Keychain TOTP code with OpenRig-Server (${server})...${RESET}"
    local resp
    resp=$(curl -sS -X POST "http://${server}/guest" \
        -H "Content-Type: application/json" \
        -d "{\"username\":\"${user}\",\"code\":\"${code}\",\"temp_public_key\":\"${pubkey}\"}")

    if ! echo "$resp" | grep -q '"status": *"guest_authorized"'; then
        echo -e "${RED}❌ Access denied: ${resp}${RESET}"
        exit 1
    fi

    local ssh_port
    ssh_port=$(echo "$resp" | python3 -c "import sys,json; print(json.load(sys.stdin)['ssh_port'])")
    local host_ip="${server%:*}"

    echo -e "${GREEN}✅ Keychain verified. Opening Guest Session (Session Takeover -> /workspace)...${RESET}"
    echo -e "${YELLOW}   (Zero keys stored on this computer; ephemeral pass is destroyed on exit)${RESET}"
    ssh -p "$ssh_port" \
        -i "${tmp_dir}/guest_key" \
        -o IdentitiesOnly=yes \
        -o StrictHostKeyChecking=no \
        -o UserKnownHostsFile=/dev/null \
        "rig@${host_ip}"
}

cmd_connect() {
    local target="${1:?Usage: ./rig connect <openrig-user | host:port>}"
    shift || true
    if grep -q "^Host ${target}$" "$HOME/.ssh/config" 2>/dev/null; then
        local hw_id dev_name
        hw_id=$(get_hardware_id)
        dev_name=$(hostname -s 2>/dev/null || hostname)
        echo -e "${CYAN}⚡ Connecting to '${target}' with dynamic Motherboard UUID verification & Session Takeover...${RESET}"
        DISPLAY=":0" \
        SSH_ASKPASS="$HOME/.openrig/hw-askpass.sh" \
        SSH_ASKPASS_REQUIRE=force \
        ssh -o SetEnv="OPENRIG_HW_ID=${hw_id} OPENRIG_DEVICE_NAME=${dev_name}" "$target" "$@"
        return 0
    fi
    local host="${target%:*}"
    local port="${target##*:}"
    [ "$host" = "$port" ] && port="2201"
    local alias_name="${1:-openrig-remote}"

    mkdir -p "$HOME/.ssh"
    touch "$HOME/.ssh/config"
    if ! grep -q "Host ${alias_name}" "$HOME/.ssh/config" 2>/dev/null; then
        cat << EOF >> "$HOME/.ssh/config"

Host ${alias_name}
    HostName ${host}
    Port ${port}
    User rig
    ForwardAgent yes
    LocalForward 3000 127.0.0.1:3000
    LocalForward 5173 127.0.0.1:5173
    LocalForward 8000 127.0.0.1:8000
    LocalForward 8080 127.0.0.1:8080
EOF
        echo -e "${GREEN}✅ Host '${alias_name}' registered in ~/.ssh/config (ready for VS Code / Antigravity Remote-SSH).${RESET}"
    fi

    echo -e "${CYAN}🌐 Connecting as Lightweight Client to OpenRig Server (${host}:${port})...${RESET}"
    ssh -A -p "$port" \
        -L 3000:127.0.0.1:3000 \
        -L 5173:127.0.0.1:5173 \
        -L 8000:127.0.0.1:8000 \
        -L 8080:127.0.0.1:8080 \
        "rig@${host}"
}

cmd_request() {
    docker exec $TTY_FLAG openrig rig-request "$@"
}

cmd_lock() {
    echo -e "${YELLOW}🔒 Activating Anti-Malware Sandbox Mode in 'openrig'...${RESET}"
    docker exec -u root openrig bash -c '
        if [ -S /var/run/docker.sock ]; then
            chown root:root /var/run/docker.sock
            chmod 600 /var/run/docker.sock
        fi
        gpasswd -d rig docker >/dev/null 2>&1 || true
        gpasswd -d rig sudo >/dev/null 2>&1 || true
        rm -f /etc/sudoers.d/rig*
        sed -i "/^rig ALL=/d" /etc/sudoers 2>/dev/null || true
    '
    echo -e "${GREEN}✅ Workstation JAILED (Sandbox Mode active):${RESET}"
    echo -e "   • Docker Socket locked (0600 root:root)."
    echo -e "   • Sudo privileges revoked inside the container."
    echo -e "   • Safe for auditing untrusted repos or running third-party npm/pip install."
    echo -e "   👉 To restore privileges from your Host OS run: ${BOLD}rig unlock${RESET}"
}

cmd_unlock() {
    echo -e "${CYAN}🔓 Restoring workstation privileges in 'openrig' from Host...${RESET}"
    docker exec -u root openrig bash -c '
        if [ -S /var/run/docker.sock ]; then
            chmod 666 /var/run/docker.sock
        fi
        usermod -aG sudo rig 2>/dev/null || true
        echo "rig ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/rig
        chmod 440 /etc/sudoers.d/rig
    '
    echo -e "${GREEN}✅ Docker and sudo privileges restored in 'openrig'.${RESET}"
}

cmd_status() {
    banner
    docker ps --filter "network=openrig-net" --format "table {{.Names}}\t{{.Image}}\t{{.Status}}\t{{.Ports}}"
}

cmd_down() {
    echo -e "${YELLOW}🛑 Stopping OpenRig containers and freeing Host OS RAM...${RESET}"
    if [ -f "$HOME/.openrig/ide-watcher.pid" ]; then
        kill "$(cat "$HOME/.openrig/ide-watcher.pid" 2>/dev/null)" 2>/dev/null || true
        rm -f "$HOME/.openrig/ide-watcher.pid"
    fi
    docker compose -f "${RIG_DIR}/docker-compose.yml" --profile services down
    echo -e "${GREEN}✅ Host OS 100% free.${RESET}"
}

cmd_uninstall() {
    echo -e "${YELLOW}🗑️  Uninstalling OpenRig container, image, and build cache...${RESET}"
    docker compose -f "${RIG_DIR}/docker-compose.yml" --profile services down --rmi all -v 2>/dev/null || true
    docker builder prune -f >/dev/null 2>&1 || true
    echo -e "${GREEN}✅ OpenRig completely uninstalled (your projects in ./workspace remain untouched).${RESET}"
}

ACTION="${1:-help}"
shift || true

case "$ACTION" in
    setup|init)      cmd_setup ;;
    up|start)        cmd_up "$@" ;;
    shell|enter)     cmd_shell ;;
    ide|code|agy)    cmd_ide "$@" ;;
    service|svc)     cmd_service "$@" ;;
    phone|adb)       cmd_phone "$@" ;;
    sec|audit)       cmd_sec "$@" ;;
    vpn)             cmd_vpn "$@" ;;
    profile|prof)    cmd_profile "$@" ;;
    snapshot|snap)   cmd_snapshot "$@" ;;
    share|tunnel)    cmd_share "$@" ;;
    device|dev)      cmd_device "$@" ;;
    request|req)     cmd_request "$@" ;;
    lock|sandbox)    cmd_lock ;;
    unlock)          cmd_unlock ;;
    join|enroll)     cmd_join "$@" ;;
    guest)           cmd_guest "$@" ;;
    connect|remote)  cmd_connect "$@" ;;
    status|ps)       cmd_status ;;
    down|stop)       cmd_down ;;
    uninstall|nuke)  cmd_uninstall ;;
    help|-h|--help|*)
        banner
        echo -e "${GREEN}${BOLD}📍 Context: HOST OS CLI (External Controller -> Controlling OpenRig Container)${RESET}\n"
        echo -e "${BOLD}Core Lifecycle & IDE Commands (Host Only):${RESET}"
        echo "  rig setup                         -> Configure Role Profile, modules, and preferred shell"
        echo "  rig up                            -> Build and start your OpenRig workstation (with % progress)"
        echo "  rig shell                         -> Enter your interactive terminal inside OpenRig"
        echo "  rig ide [path]                    -> Open Antigravity IDE / VS Code attached to OpenRig"
        echo "  rig down                          -> Stop all containers and free 100% of Host RAM"
        echo "  rig uninstall                     -> Uninstall container & image (preserves ./workspace)"
        echo "  rig lock / rig unlock             -> Toggle Anti-Malware Sandbox Mode (unlock is Host-only)"
        echo ""
        echo -e "${BOLD}Workstation Tools (Available both on Host & Inside Container):${RESET}"
        echo "  rig profile [create|use|list]     -> Isolate Git author & AWS credentials per client/company"
        echo "  rig vpn [gp|ovpn|wg|status|down]  -> Isolated container VPN (GlobalProtect, OpenVPN, WireGuard)"
        echo "  rig snapshot [save|restore|list]  -> Time Machine: freeze or restore workstation state"
        echo "  rig service [up|down] <name>      -> Manage sibling containers (postgres, redis, localstack)"
        echo "  rig sec [path]                    -> Run Security Audit (Gitleaks + Trivy + Semgrep)"
        echo "  rig share [port]                  -> Expose a local port via public HTTPS for demos/webhooks"
        echo "  rig phone [pair|connect|usb-bridge]-> Connect physical Android phone over Wi-Fi/USB to OpenRig"
        echo "  rig status                        -> Show active OpenRig & sibling containers"
        echo ""
        echo -e "${BOLD}Remote OpenRig-Server & Zero-Trust Fleet Commands:${RESET}"
        echo "  rig join <srv:7070> --token <t>   -> Bind your machine by Hardware UUID to an OpenRig-Server"
        echo "  rig connect <openrig-user>        -> Connect to remote workstation (with Session Takeover)"
        echo "  rig guest <srv:7070> --user <u>   -> Zero-trace Guest Mode using your TOTP Keychain"
        echo "  rig request <ram> <cpus> [note]   -> Request live RAM or vCPU hot-scaling from Server Manager"
        echo "  rig device [list|revoke|keychain] -> Manage bound devices and your TOTP Keychain"
        echo "  rig -h | rig --help               -> Show this Host CLI command reference"
        ;;
esac
