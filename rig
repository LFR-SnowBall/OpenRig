cmd_snapshot() {
    local sub="${1:-list}"
    shift || true
    case "$sub" in
        save|create)
            local tag="${1:?Uso: ./rig snapshot save <nombre-snapshot>}"
            echo -e "${CYAN}📸 Guardando snapshot de tu estación OpenRig como 'openrig-snapshot:${tag}'...${RESET}"
            docker commit openrig "openrig-snapshot:${tag}" >/dev/null
            echo -e "${GREEN}✅ Snapshot 'openrig-snapshot:${tag}' guardado con éxito.${RESET}"
            ;;
        list|ls)
            echo -e "${CYAN}📸 Snapshots disponibles (Time Machine):${RESET}"
            docker images "openrig-snapshot" --format "table {{.Repository}}:{{.Tag}}\t{{.CreatedSince}}\t{{.Size}}"
            ;;
        restore)
            local tag="${1:?Uso: ./rig snapshot restore <nombre-snapshot>}"
            ensure_env
            local role
            role=$(grep -E '^OPENRIG_ROLE=' "$ENV_FILE" | cut -d= -f2 || echo "fullstack")
            echo -e "${YELLOW}⏪ Restaurando estación OpenRig al snapshot 'openrig-snapshot:${tag}'...${RESET}"
            docker tag "openrig-snapshot:${tag}" "openrig:${role}"
            docker compose -f "${RIG_DIR}/docker-compose.yml" --env-file "$ENV_FILE" up -d --force-recreate
            echo -e "${GREEN}✅ Estación restaurada al estado '${tag}'.${RESET}"
            ;;
        export)
            local tag="${1:?Uso: ./rig snapshot export <nombre-snapshot> [archivo.tar.gz]}"
            local out="${2:-openrig-${tag}.tar.gz}"
            echo -e "${CYAN}📦 Exportando snapshot '${tag}' a ${out}...${RESET}"
            docker save "openrig-snapshot:${tag}" | gzip > "$out"
            echo -e "${GREEN}✅ Exportado en: ${out}${RESET}"
            ;;
        import)
            local file="${1:?Uso: ./rig snapshot import <archivo.tar.gz> [nombre-snapshot]}"
            local tag="${2:-imported}"
            echo -e "${CYAN}📥 Importando snapshot desde ${file}...${RESET}"
            gunzip -c "$file" | docker load
            echo -e "${GREEN}✅ Snapshot importado.${RESET}"
            ;;
        *)
            echo "📸 OpenRig Time Machine (rig snapshot):"
            echo "  ./rig snapshot save <tag>              -> Congela el estado actual de tu estación"
            echo "  ./rig snapshot list                    -> Lista tus snapshots guardados"
            echo "  ./rig snapshot restore <tag>           -> Regresa tu estación en el tiempo al snapshot"
            echo "  ./rig snapshot export <tag> [file.tgz] -> Empaqueta tu estación para llevarla en USB/Red"
            echo "  ./rig snapshot import <file.tgz>       -> Importa una estación empaquetada"
            ;;
    esac
}

get_hardware_id() {
    local raw=""
    if command -v ioreg >/dev/null 2>&1; then
        raw=$(ioreg -rd1 -c IOPlatformExpertDevice | awk -F\" '/IOPlatformUUID/{print $4}')
    elif [ -f /etc/machine-id ]; then
        raw=$(cat /etc/machine-id)
    else
        raw="$(hostname)-$(uname -m)"
    fi
    printf "%s" "$raw" | shasum -a 256 | awk '{print $1}'
}

