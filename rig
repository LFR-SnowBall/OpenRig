set -euo pipefail

SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
    DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
    SOURCE="$(readlink "$SOURCE")"
    [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
RIG_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
ENV_FILE="${RIG_DIR}/.env"

# Ensure OrbStack, Homebrew and local bins are in PATH
export PATH="${HOME}/.orbstack/bin:/Applications/OrbStack.app/Contents/MacOS/xbin:/opt/homebrew/bin:/usr/local/bin:$PATH"

# Colors
CYAN="\033[96m"
GREEN="\033[92m"
YELLOW="\033[93m"
RED="\033[91m"
BOLD="\033[1m"
RESET="\033[0m"

banner() {
    echo -e "${CYAN}${BOLD}"
    echo "╔══════════════════════════════════════════════════════════════════════════╗"
    echo "║   ⚡ OPENRIG — PORTABLE MODULAR DEV, SEC & AI WORKSTATION                ║"
    echo "║   By Linux Open Source S.A. de C.V.                                      ║"
    echo "╚══════════════════════════════════════════════════════════════════════════╝"
    echo -e "${RESET}"
}

ask_yn() {
    local prompt="$1"
    local default="${2:-y}"
    local yn
    if [ "$default" = "y" ]; then
        read -r -p "$(echo -e "${BOLD}${prompt} [Y/n]: ${RESET}")" yn
        yn="${yn:-y}"
    else
        read -r -p "$(echo -e "${BOLD}${prompt} [y/N]: ${RESET}")" yn
        yn="${yn:-n}"
    fi
    case "$yn" in
        [Yy]* ) echo "true" ;;
        * ) echo "false" ;;
    esac
}

