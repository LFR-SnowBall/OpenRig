    echo -e "${BOLD}Selecciona el Rol para configurar tu máquina OpenRig:${RESET}\n"
    echo "  1) 🐍 Backend Python     (pyenv + uv, Python multi-versión, Django, Flask, FastAPI)"
    echo "  2) ☕ Backend JVM        (SDKMAN!, Java 21/17, Kotlin, Spring Boot, Maven, Gradle)"
