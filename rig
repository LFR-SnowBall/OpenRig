cmd_join() {
    local server="${1:?Uso: rig join <servidor:7070> --token <rig_inv_...>}"
    shift || true
    local token=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --token|-t) token="$2"; shift 2 ;;
            *) token="$1"; shift ;;
        esac
    done
    if [ -z "$token" ]; then
        echo -e "${RED}❌ Falta el token de invitación (--token rig_inv_...).${RESET}"
        exit 1
    fi

    local hw_id
    hw_id=$(get_hardware_id)
    local dev_name
    dev_name=$(hostname -s 2>/dev/null || hostname)
    local key_dir="$HOME/.openrig"
    mkdir -p "$key_dir"
    chmod 700 "$key_dir"
    local key_file="$key_dir/device_ed25519"
    local askpass_file="$key_dir/hw-askpass.sh"

    cat << 'ASKPASS' > "$askpass_file"
#!/usr/bin/env bash
if [[ "$OSTYPE" == "darwin"* ]]; then
    raw=$(ioreg -rd1 -c IOPlatformExpertDevice | awk -F'"' '/IOPlatformUUID/{print $4}')
elif [ -f /sys/class/dmi/id/product_uuid ]; then
    raw=$(cat /sys/class/dmi/id/product_uuid 2>/dev/null || cat /etc/machine-id)
elif [ -f /etc/machine-id ]; then
    raw=$(cat /etc/machine-id)
else
    raw="$(hostname)-$(uname -m)"
fi
printf "%s" "$raw" | shasum -a 256 | awk '{print $1}'
ASKPASS
    chmod 700 "$askpass_file"

    # Regenerate hardware-encrypted key so it cannot be decrypted on any other motherboard
    rm -f "$key_file" "${key_file}.pub"
    ssh-keygen -t ed25519 -f "$key_file" -N "$hw_id" -C "openrig-bound-${dev_name}" >/dev/null
    local pubkey
    pubkey=$(cat "${key_file}.pub")

    echo -e "${CYAN}🔐 Casando este equipo (${dev_name} | HW-ID derivado en RAM) con OpenRig-Server (${server})...${RESET}"
    local resp
    resp=$(curl -sS -X POST "http://${server}/enroll" \
        -H "Content-Type: application/json" \
        -d "{\"token\":\"${token}\",\"public_key\":\"${pubkey}\",\"hardware_id\":\"${hw_id}\",\"device_name\":\"${dev_name}\"}")

    if ! echo "$resp" | grep -q '"status": *"enrolled"'; then
        echo -e "${RED}❌ Error al registrar equipo: ${resp}${RESET}"
        exit 1
    fi

    local user ssh_port kc_secret kc_uri
    user=$(echo "$resp" | python3 -c "import sys,json; print(json.load(sys.stdin)['username'])")
    ssh_port=$(echo "$resp" | python3 -c "import sys,json; print(json.load(sys.stdin)['ssh_port'])")
    kc_secret=$(echo "$resp" | python3 -c "import sys,json; print(json.load(sys.stdin)['keychain_secret'])")
    kc_uri=$(echo "$resp" | python3 -c "import sys,json; print(json.load(sys.stdin)['keychain_uri'])")
    local host_ip="${server%:*}"

    mkdir -p "$HOME/.ssh"
    touch "$HOME/.ssh/config"
    # Remove previous entry for openrig-${user} if exists
    python3 - "$HOME/.ssh/config" "openrig-${user}" << 'PY'
import re, sys
p, alias = sys.argv[1], sys.argv[2]
txt = open(p).read()
txt = re.sub(rf"\nHost {re.escape(alias)}\n(?:    .*\n)*", "\n", txt)
open(p, "w").write(txt)
PY

    cat << EOF >> "$HOME/.ssh/config"

Host openrig-${user}
    HostName ${host_ip}
    Port ${ssh_port}
    User rig
    IdentityFile ${key_file}
    IdentitiesOnly yes
    StrictHostKeyChecking accept-new
    LocalForward 3000 127.0.0.1:3000
    LocalForward 5173 127.0.0.1:5173
    LocalForward 8000 127.0.0.1:8000
    LocalForward 8080 127.0.0.1:8080
EOF

    echo -e "${GREEN}✅ ¡Equipo '${dev_name}' casado exitosamente y equipos anteriores desvinculados!${RESET}"
    echo -e "   • Llave privada cifrada con el chip de esta placa madre (inútil si la copian a otra PC)."
    echo -e "   • Conéctate en 1 segundo con: ${BOLD}rig connect openrig-${user}${RESET}"
    echo -e "   • Keychain TOTP (para Modo Invitado 'rig guest' en otra PC): ${YELLOW}${kc_secret}${RESET}"
    echo -e "   • URI 1Password / Authenticator: ${kc_uri}"
}

cmd_guest() {
    local server="${1:?Uso: rig guest <servidor:7070> --user <usuario> [--code <6-digitos-llavero>]}"
    shift || true
    local user=""
    local code=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --user|-u) user="$2"; shift 2 ;;
            --code|-c) code="$2"; shift 2 ;;
            *) [ -z "$user" ] && user="$1"; shift ;;
        esac
    done

    if [ -z "$user" ]; then
        read -r -p "👤 Usuario en OpenRig-Server: " user
    fi
    if [ -z "$code" ]; then
        read -r -p "🔐 Código de 6 dígitos de tu Llavero (1Password / Authenticator): " code
    fi

    local tmp_dir
    tmp_dir=$(mktemp -d /tmp/rig-guest-XXXXXX)
    trap 'rm -rf "$tmp_dir"' EXIT INT TERM

    ssh-keygen -t ed25519 -f "${tmp_dir}/guest_key" -N "" -C "guest-ephemeral" >/dev/null
    local pubkey
    pubkey=$(cat "${tmp_dir}/guest_key.pub")

    echo -e "${CYAN}🔑 Verificando código de Llavero con OpenRig-Server (${server})...${RESET}"
    local resp
    resp=$(curl -sS -X POST "http://${server}/guest" \
        -H "Content-Type: application/json" \
        -d "{\"username\":\"${user}\",\"code\":\"${code}\",\"temp_public_key\":\"${pubkey}\"}")

    if ! echo "$resp" | grep -q '"status": *"guest_authorized"'; then
        echo -e "${RED}❌ Acceso denegado: ${resp}${RESET}"
        exit 1
    fi

    local ssh_port
    ssh_port=$(echo "$resp" | python3 -c "import sys,json; print(json.load(sys.stdin)['ssh_port'])")
    local host_ip="${server%:*}"

    echo -e "${GREEN}✅ Llavero verificado. Abriendo Sesión de Invitado (Session Takeover -> /workspace)...${RESET}"
    echo -e "${YELLOW}   (Cero llaves guardadas en esta computadora; al salir se destruye el pase temporal)${RESET}"
    ssh -p "$ssh_port" \
        -i "${tmp_dir}/guest_key" \
        -o IdentitiesOnly=yes \
        -o StrictHostKeyChecking=no \
        -o UserKnownHostsFile=/dev/null \
        "rig@${host_ip}"
}

cmd_connect() {
    local target="${1:?Uso: ./rig connect <openrig-usuario | host:puerto>}"
    shift || true
    if grep -q "^Host ${target}$" "$HOME/.ssh/config" 2>/dev/null; then
        local hw_id dev_name
        hw_id=$(get_hardware_id)
        dev_name=$(hostname -s 2>/dev/null || hostname)
        echo -e "${CYAN}⚡ Conectando a '${target}' con verificación dinámica de Placa Madre (RAM) y Session Takeover...${RESET}"
        DISPLAY=":0" \
        SSH_ASKPASS="$HOME/.openrig/hw-askpass.sh" \
        SSH_ASKPASS_REQUIRE=force \
        ssh -o SetEnv="OPENRIG_HW_ID=${hw_id} OPENRIG_DEVICE_NAME=${dev_name}" "$target" "$@"
        return 0
    fi
    local host="${target%:*}"
    local port="${target##*:}"
    [ "$host" = "$port" ] && port="2201"
    local alias_name="${1:-openrig-remote}"

    mkdir -p "$HOME/.ssh"
    touch "$HOME/.ssh/config"
    if ! grep -q "Host ${alias_name}" "$HOME/.ssh/config" 2>/dev/null; then
        cat << EOF >> "$HOME/.ssh/config"

Host ${alias_name}
    HostName ${host}
    Port ${port}
    User rig
    ForwardAgent yes
    LocalForward 3000 127.0.0.1:3000
    LocalForward 5173 127.0.0.1:5173
    LocalForward 8000 127.0.0.1:8000
    LocalForward 8080 127.0.0.1:8080
EOF
        echo -e "${GREEN}✅ Host '${alias_name}' registrado en ~/.ssh/config (listo para VS Code / Antigravity Remote-SSH).${RESET}"
    fi

    echo -e "${CYAN}🌐 Conectando como Cliente Ligero a OpenRig Server (${host}:${port})...${RESET}"
    ssh -A -p "$port" \
        -L 3000:127.0.0.1:3000 \
        -L 5173:127.0.0.1:5173 \
        -L 8000:127.0.0.1:8000 \
        -L 8080:127.0.0.1:8080 \
        "rig@${host}"
}

cmd_request() {
    docker exec $TTY_FLAG openrig rig-request "$@"
}

cmd_lock() {
    echo -e "${YELLOW}🔒 Activando Modo Sandbox Anti-Malware en 'openrig'...${RESET}"
    docker exec -u root openrig bash -c '
        if [ -S /var/run/docker.sock ]; then
            chown root:root /var/run/docker.sock
            chmod 600 /var/run/docker.sock
        fi
        gpasswd -d rig docker >/dev/null 2>&1 || true
        gpasswd -d rig sudo >/dev/null 2>&1 || true
        rm -f /etc/sudoers.d/rig*
        sed -i "/^rig ALL=/d" /etc/sudoers 2>/dev/null || true
    '
    echo -e "${GREEN}✅ Estación ENJAULADA (Modo Sandbox activo):${RESET}"
    echo -e "   • Socket de Docker bloqueado (0600 root:root)."
    echo -e "   • Permisos sudo revocados dentro del contenedor."
    echo -e "   • Seguro para probar repositorios desconocidos o correr npm/pip install de terceros."
    echo -e "   👉 Para restaurar privilegios desde tu Mac/PC ejecuta: ${BOLD}rig unlock${RESET}"
}

cmd_unlock() {
    echo -e "${CYAN}🔓 Restaurando privilegios de estación en 'openrig' desde el Host...${RESET}"
    docker exec -u root openrig bash -c '
        if [ -S /var/run/docker.sock ]; then
            chmod 666 /var/run/docker.sock
        fi
        usermod -aG sudo rig 2>/dev/null || true
        echo "rig ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/rig
        chmod 440 /etc/sudoers.d/rig
    '
    echo -e "${GREEN}✅ Privilegios de Docker y sudo restaurados en 'openrig'.${RESET}"
}

cmd_status() {
    banner
    docker ps --filter "network=openrig-net" --format "table {{.Names}}\t{{.Image}}\t{{.Status}}\t{{.Ports}}"
}

cmd_down() {
    echo -e "${YELLOW}🛑 Apagando contenedores de OpenRig y liberando RAM del sistema...${RESET}"
    docker compose -f "${RIG_DIR}/docker-compose.yml" --profile services down
    echo -e "${GREEN}✅ Máquina anfitrión 100% libre.${RESET}"
}

cmd_uninstall() {
    echo -e "${YELLOW}🗑️  Desinstalando contenedor, imagen y caché de construcción de OpenRig...${RESET}"
    docker compose -f "${RIG_DIR}/docker-compose.yml" --profile services down --rmi all -v 2>/dev/null || true
    docker builder prune -f >/dev/null 2>&1 || true
    echo -e "${GREEN}✅ OpenRig desinstalado por completo (tus proyectos en ./workspace siguen intactos).${RESET}"
}

ACTION="${1:-help}"
shift || true

case "$ACTION" in
    setup|init)      cmd_setup ;;
    up|start)        cmd_up "$@" ;;
    shell|enter)     cmd_shell ;;
    service|svc)     cmd_service "$@" ;;
    phone|adb)       cmd_phone "$@" ;;
    sec|audit)       cmd_sec "$@" ;;
    vpn)             cmd_vpn "$@" ;;
    profile|prof)    cmd_profile "$@" ;;
    snapshot|snap)   cmd_snapshot "$@" ;;
    share|tunnel)    cmd_share "$@" ;;
    device|dev)      cmd_device "$@" ;;
    request|req)     cmd_request "$@" ;;
    lock|sandbox)    cmd_lock ;;
    unlock)          cmd_unlock ;;
    join|enroll)     cmd_join "$@" ;;
    guest)           cmd_guest "$@" ;;
    connect|remote)  cmd_connect "$@" ;;
    status|ps)       cmd_status ;;
    down|stop)       cmd_down ;;
    uninstall|nuke)  cmd_uninstall ;;
    *)
        banner
        echo -e "${BOLD}Comandos principales:${RESET}"
        echo "  ./rig setup                       -> Configura tu Rol, módulos y terminal favorita"
        echo "  ./rig up                          -> Construye e inicia tu estación OpenRig (con % de progreso)"
        echo "  ./rig shell                       -> Entra a tu terminal dentro de OpenRig"
        echo "  ./rig down                        -> Apaga todo y libera el 100% de la RAM de tu computadora"
        echo "  ./rig uninstall                   -> Desinstala contenedor e imagen (conserva ./workspace)"
        echo ""
        echo -e "${BOLD}Diferenciadores & Herramientas Avanzadas:${RESET}"
        echo "  ./rig profile [create|use|list]   -> Aísla identidad Git y AWS por cliente/empresa"
        echo "  ./rig vpn [gp|ovpn|wg|status|down]-> VPN aislada en contenedor (GlobalProtect, OpenVPN, WireGuard)"
        echo "  ./rig snapshot [save|restore|list]-> Time Machine: congela o restaura el estado de tu estación"
        echo "  ./rig share <puerto>              -> Expone un puerto local por HTTPS público para demos/webhooks"
        echo "  ./rig service up <nombre>         -> Levanta contenedores hermanos (postgres, redis, localstack)"
        echo "  ./rig phone connect <IP:PORT>     -> Conecta tu celular Android por Wi-Fi a OpenRig"
        echo "  ./rig sec [ruta]                  -> Auditoría de seguridad (Gitleaks + Trivy + Semgrep)"
        echo "  ./rig lock / ./rig unlock         -> Modo Sandbox Anti-Malware (bloquea Docker socket y sudo)"
        echo "  ./rig join <srv:7070> --token <t> -> Casa tu equipo por Hardware UUID con un OpenRig-Server"
        echo "  ./rig connect <openrig-usuario>   -> Entra a tu sesión remota (con Session Takeover)"
        echo "  ./rig guest <srv:7070> --user <u> -> Modo Invitado sin dejar rastro usando tu Llavero (TOTP)"
        echo "  ./rig request <ram> <cpus> [razon]-> Solicita al Administrador más RAM o CPUs virtuales"
        echo "  ./rig device [list|revoke|keychain]-> Administra equipos casados y tu Llavero TOTP"
        ;;
esac
