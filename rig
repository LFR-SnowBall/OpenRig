set -euo pipefail

SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
    DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
    SOURCE="$(readlink "$SOURCE")"
    [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
RIG_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
ENV_FILE="${RIG_DIR}/.env"

# Ensure OrbStack, Homebrew and local bins are in PATH
export PATH="${HOME}/.orbstack/bin:/Applications/OrbStack.app/Contents/MacOS/xbin:/opt/homebrew/bin:/usr/local/bin:$PATH"

# Colors
CYAN="\033[96m"
GREEN="\033[92m"
YELLOW="\033[93m"
RED="\033[91m"
BOLD="\033[1m"
RESET="\033[0m"

banner() {
    echo -e "${CYAN}${BOLD}"
    echo "╔══════════════════════════════════════════════════════════════════════════╗"
    echo "║   ⚡ OPENRIG — PORTABLE MODULAR DEV, SEC & AI WORKSTATION                ║"
    echo "║   By Linux Open Source S.A. de C.V.                                      ║"
    echo "╚══════════════════════════════════════════════════════════════════════════╝"
    echo -e "${RESET}"
}

ask_yn() {
    local prompt="$1"
    local default="${2:-y}"
    local yn
    if [ "$default" = "y" ]; then
        read -r -p "$(echo -e "${BOLD}${prompt} [Y/n]: ${RESET}")" yn
        yn="${yn:-y}"
    else
        read -r -p "$(echo -e "${BOLD}${prompt} [y/N]: ${RESET}")" yn
        yn="${yn:-n}"
    fi
    case "$yn" in
        [Yy]* ) echo "true" ;;
        * ) echo "false" ;;
    esac
}

cmd_setup() {
    banner
    echo -e "${BOLD}Select the Role Profile for your OpenRig Workstation:${RESET}\n"
    echo "  1) 🐍 Backend Python     (pyenv + uv, multi-version Python, Django, Flask, FastAPI)"
    echo "  2) ☕ Backend JVM        (SDKMAN!, Java 21/17, Kotlin, Spring Boot, Maven, Gradle)"
    echo "  3) 🎨 Frontend & Web     (nvm, Node LTS, Vue.js, React, Vite, pnpm, Yarn, Bun)"
    echo "  4) 📱 Mobile & Flutter   (Flutter, FVM, Dart, Android SDK CLI, ADB Wi-Fi/USB)"
    echo "  5) 🛡️  DevSecOps & Pentest(nmap, nuclei, trivy, semgrep, gitleaks, sqlmap, AWS CLI)"
    echo "  6) 🦾 Full-Stack Core    (Python + JVM + Node + Cloud + Security + AI CLIs)"
    echo "  7) 🧩 Custom Modular     (Manually toggle individual modules)"
    echo ""
    read -r -p "👉 Choose an option [1-7] (default: 6): " choice
    choice="${choice:-6}"

    INSTALL_PYTHON=false
    INSTALL_JVM=false
    INSTALL_NODE=false
    INSTALL_MOBILE=false
    INSTALL_SWIFT=false
    INSTALL_CLOUD=true
    INSTALL_SEC=false
    INSTALL_AI=true
    OPENRIG_ROLE="custom"

    case "$choice" in
        1)
            OPENRIG_ROLE="backend-python"
            INSTALL_PYTHON=true
            ;;
        2)
            OPENRIG_ROLE="backend-jvm"
            INSTALL_JVM=true
            ;;
        3)
            OPENRIG_ROLE="frontend"
            INSTALL_NODE=true
            ;;
        4)
            OPENRIG_ROLE="mobile"
            INSTALL_JVM=true
            INSTALL_NODE=true
            INSTALL_MOBILE=true
            ;;
        5)
            OPENRIG_ROLE="sec-devops"
            INSTALL_PYTHON=true
            INSTALL_CLOUD=true
            INSTALL_SEC=true
            ;;
        6)
            OPENRIG_ROLE="fullstack"
            INSTALL_PYTHON=true
            INSTALL_JVM=true
            INSTALL_NODE=true
            INSTALL_CLOUD=true
            INSTALL_SEC=true
            INSTALL_AI=true
            ;;
        7)
            OPENRIG_ROLE="custom"
            echo ""
            echo -e "${CYAN}--- Custom Modular Configuration ---${RESET}"
            INSTALL_PYTHON=$(ask_yn "🐍 Include Python (pyenv + uv + Django/Flask/FastAPI)?" "y")
            INSTALL_JVM=$(ask_yn "☕ Include JVM (SDKMAN! + Java + Kotlin + Spring Boot)?" "y")
            INSTALL_NODE=$(ask_yn "🎨 Include Node.js (nvm + Vue.js + React + Vite)?" "y")
            INSTALL_MOBILE=$(ask_yn "📱 Include Mobile (Flutter + Android SDK CLI + ADB)?" "n")
            INSTALL_SWIFT=$(ask_yn "🍎 Include Swift Linux Toolchain (swiftly)?" "n")
            INSTALL_CLOUD=$(ask_yn "☁️  Include Cloud & DB CLIs (AWS CLI v2, Postgres/Redis)?" "y")
            INSTALL_SEC=$(ask_yn "🛡️  Include Security & Pentest (nmap, nuclei, trivy, semgrep)?" "y")
            INSTALL_AI=$(ask_yn "🤖 Include Sandboxed AI CLIs (Claude, Gemini, Codex, Aider)?" "y")
            ;;
        *)
            echo -e "${RED}Invalid option.${RESET}"
            exit 1
            ;;
    esac

    echo ""
    echo -e "${BOLD}Select your preferred Shell inside OpenRig:${RESET}"
    echo "  1) ⚡ Oh My Zsh + Autosuggestions (Default / Recommended)"
    echo "  2) 🚀 Zsh + Starship Prompt"
    echo "  3) 🐟 Fish Shell"
    echo "  4) 🐚 Classic Bash"
    read -r -p "👉 Choose your shell [1-4] (default: 1): " sh_choice
    sh_choice="${sh_choice:-1}"
    OPENRIG_SHELL="ohmyzsh"
    case "$sh_choice" in
        2) OPENRIG_SHELL="starship" ;;
        3) OPENRIG_SHELL="fish" ;;
        4) OPENRIG_SHELL="bash" ;;
        *) OPENRIG_SHELL="ohmyzsh" ;;
    esac

    cat << EOF > "$ENV_FILE"
# Generated by OpenRig Setup ($(date +%Y-%m-%d))
OPENRIG_ROLE=${OPENRIG_ROLE}
OPENRIG_SHELL=${OPENRIG_SHELL}
INSTALL_PYTHON=${INSTALL_PYTHON}
INSTALL_JVM=${INSTALL_JVM}
INSTALL_NODE=${INSTALL_NODE}
INSTALL_MOBILE=${INSTALL_MOBILE}
INSTALL_SWIFT=${INSTALL_SWIFT}
INSTALL_CLOUD=${INSTALL_CLOUD}
INSTALL_SEC=${INSTALL_SEC}
INSTALL_AI=${INSTALL_AI}
PYTHON_DEFAULT_VERSION=3.12
NODE_DEFAULT_VERSION=22
JAVA_DEFAULT_VERSION=21.0.5-tem
CONTAINER_NAME=openrig
HOST_WORKSPACE_PATH=${RIG_DIR}/workspace
EOF

    echo ""
    echo -e "${GREEN}✅ Configuration file (.env) generated with profile '${OPENRIG_ROLE}'.${RESET}"
    echo -e "💡 Run ${BOLD}./rig up${RESET} now to build and start your workstation."
}

ensure_env() {
    if [ ! -f "$ENV_FILE" ]; then
        echo -e "${YELLOW}ℹ️ No existing configuration (.env) found. Launching setup wizard...${RESET}"
        cmd_setup
    fi
}

MAX_PCT=0
LAST_STAGE=""
draw_progress() {
    local pct="$1"
    local msg="$2"
    local is_milestone="${3:-false}"
    if [ "$pct" -lt "$MAX_PCT" ]; then
        pct="$MAX_PCT"
    else
        MAX_PCT="$pct"
    fi
    local width=28
    local filled=$(( pct * width / 100 ))
    local empty=$(( width - filled ))
    local bar=""
    for ((i=0; i<filled; i++)); do bar+="█"; done
    for ((i=0; i<empty; i++)); do bar+="░"; done

    if [ "$is_milestone" = "true" ] && [ "$msg" != "$LAST_STAGE" ]; then
        printf "\r\033[K${GREEN}✔${RESET} ${CYAN}[%s] ${BOLD}%3d%%${RESET} — %s\n" "$bar" "$pct" "$msg"
        LAST_STAGE="$msg"
    else
        printf "\r\033[K${CYAN}[%s] ${BOLD}%3d%%${RESET} — %s" "$bar" "$pct" "$msg"
    fi
}

cmd_up() {
    ensure_env
    local role
    role=$(grep -E '^OPENRIG_ROLE=' "$ENV_FILE" | cut -d= -f2 || echo "fullstack")
    local image_name="openrig:${role}"
    local build_log="/tmp/openrig-build.log"
    local no_cache_flag=""
    if [[ "${1:-}" == "--no-cache" ]]; then
        no_cache_flag="--no-cache"
        shift || true
    fi

    echo -e "${CYAN}${BOLD}🚀 Preparing OpenRig Workstation (Profile: ${role})...${RESET}"
    draw_progress 5 "Checking container runtime (Docker / OrbStack)..." "true"

    if ! docker image inspect "$image_name" >/dev/null 2>&1 || [[ -n "$no_cache_flag" ]] || [[ "${1:-}" == "--rebuild" ]]; then
        [[ "${1:-}" == "--rebuild" ]] && shift || true
        echo -e "${YELLOW}📦 Building modular image '${image_name}' (Detailed log at ${build_log})...${RESET}"
        draw_progress 8 "📥 [0/7] Preparing Ubuntu 24.04 LTS base image..." "true"

        set +e
        docker compose -f "${RIG_DIR}/docker-compose.yml" --env-file "$ENV_FILE" build $no_cache_flag --progress=plain 2>&1 | tee "$build_log" | while IFS= read -r line; do
            if [[ "$line" == *"Installing Base Workstation"* ]]; then
                draw_progress 12 "🧱 [1/7] Installing Base System (Ubuntu + Oh My Zsh + Docker CLI)..." "true"
            elif [[ "$line" == *"Installing Docker CLI"* ]]; then
                draw_progress 18 "🐳 [1/7] Configuring Docker CLI for Sibling Containers..." "true"
            elif [[ "$line" == *"Base system ready"* ]]; then
                draw_progress 22 "✅ [1/7] Base System complete." "true"
            elif [[ "$line" == *"Installing Python Module"* ]]; then
                draw_progress 26 "🐍 [2/7] Installing Python (uv + pyenv + Python 3.12)..." "true"
            elif [[ "$line" == *"Installed 1 executable: django-admin"* ]]; then
                draw_progress 34 "🐍 [2/7] Python Frameworks ready (Django, Flask, FastAPI, Ruff, Pytest)..." "true"
            elif [[ "$line" == *"Installing JVM Module"* ]]; then
                draw_progress 40 "☕ [3/7] Installing JVM via SDKMAN! (Java 21 LTS)..." "true"
            elif [[ "$line" == *"Installing: kotlin"* ]]; then
                draw_progress 46 "☕ [3/7] Installing Kotlin & Spring Boot CLI..." "true"
            elif [[ "$line" == *"Installing: gradle"* ]]; then
                draw_progress 52 "☕ [3/7] Installing Apache Maven & Gradle..." "true"
            elif [[ "$line" == *"Installing Node & Frontend"* ]]; then
                draw_progress 58 "🎨 [4/7] Installing Node.js via NVM + Vue.js + React + Vite..." "true"
            elif [[ "$line" == *"Node & Frontend module installed"* ]]; then
                draw_progress 66 "✅ [4/7] Frontend & Node.js environment complete." "true"
            elif [[ "$line" == *"Installing Mobile"* ]]; then
                draw_progress 68 "📱 [4b/7] Installing Mobile (Flutter + Android SDK CLI + ADB)..." "true"
            elif [[ "$line" == *"Installing Cloud"* ]]; then
                draw_progress 72 "☁️  [5/7] Installing Cloud & DBs (AWS CLI v2 + kubectl + Postgres/Redis)..." "true"
            elif [[ "$line" == *"Installing Security"* ]]; then
                draw_progress 80 "🛡️  [6/7] Installing Security Suite (Trivy, Semgrep, Nuclei, Nmap, Gitleaks)..." "true"
            elif [[ "$line" == *"Security & Pentesting module installed"* ]]; then
                draw_progress 87 "✅ [6/7] Security & Pentesting Suite ready." "true"
            elif [[ "$line" == *"Installing AI Coding"* ]]; then
                draw_progress 90 "🤖 [7/7] Installing Sandboxed AI Agents (Claude, Gemini, Codex, Aider)..." "true"
            elif [[ "$line" == *"exporting to image"* ]]; then
                draw_progress 95 "💾 Exporting image layers to disk..." "true"
            elif [[ "$line" == *"unpacking to"* ]]; then
                draw_progress 98 "📂 Unpacking final workstation image..." "true"
            fi
        done
        local build_rc="${PIPESTATUS[0]}"
        set -e
        if [ "$build_rc" -ne 0 ]; then
            echo ""
            echo -e "${RED}❌ Build failed. Inspect the last lines of ${build_log}:${RESET}"
            tail -n 25 "$build_log"
            exit "$build_rc"
        fi
    else
        draw_progress 60 "⚡ Image '${image_name}' found in local cache..." "true"
    fi

    draw_progress 99 "🔌 Starting 'openrig-net' network, cache volumes, and IDE Remote-SSH bridge..." "true"
    docker compose -f "${RIG_DIR}/docker-compose.yml" --env-file "$ENV_FILE" up -d "$@" >/dev/null 2>&1
    # Sync ONLY safe public SSH files (*.pub, known_hosts, allowed_signers) — never mount or copy private keys
    docker exec openrig mkdir -p /home/rig/.ssh >/dev/null 2>&1 || true
    for pub_file in "$HOME/.ssh/"*.pub "$HOME/.ssh/known_hosts" "$HOME/.ssh/allowed_signers"; do
        [ -f "$pub_file" ] && docker cp "$pub_file" "openrig:/home/rig/.ssh/" >/dev/null 2>&1 || true
    done
    # Configure zero-popup Local IDE SSH Bridge (Host 'openrig' on 127.0.0.1:2222 for Antigravity / VS Code / Cursor)
    mkdir -p "$HOME/.openrig" "$HOME/.ssh"
    chmod 700 "$HOME/.openrig" "$HOME/.ssh"
    local ide_key="$HOME/.openrig/local_ide_ed25519"
    if [ ! -f "$ide_key" ]; then
        ssh-keygen -t ed25519 -f "$ide_key" -N "" -C "openrig-local-ide" >/dev/null 2>&1
    fi
    local ide_pub
    ide_pub=$(cat "${ide_key}.pub")
    docker exec -u root openrig bash -c "mkdir -p /etc/openrig /home/rig/.ssh /run/sshd && echo '${ide_pub}' > /etc/openrig/authorized_keys && echo '${ide_pub}' > /home/rig/.ssh/authorized_keys && chown root:root /etc/openrig/authorized_keys && chmod 644 /etc/openrig/authorized_keys && chown -R rig:rig /home/rig/.ssh && chmod 700 /home/rig/.ssh && chmod 600 /home/rig/.ssh/authorized_keys && (pgrep -x sshd >/dev/null || /usr/sbin/sshd)" >/dev/null 2>&1 || true
    touch "$HOME/.ssh/config"
    python3 - "$HOME/.ssh/config" "$ide_key" << 'PY'
import re, sys
p, key_file = sys.argv[1], sys.argv[2]
txt = open(p).read()
txt = re.sub(r"\n?Host openrig\n(?:    .*\n)*", "\n", txt)
block = f"""Host openrig
    HostName 127.0.0.1
    Port 2222
    User rig
    IdentityFile {key_file}
    IdentityAgent none
    IdentitiesOnly yes
    StrictHostKeyChecking no
    UserKnownHostsFile /dev/null
    LogLevel ERROR

"""
if "Host *" in txt:
    txt = txt.replace("Host *", block + "Host *", 1)
else:
    txt = txt.rstrip() + "\n\n" + block
open(p, "w").write(txt)
PY
    start_ide_bridge_watcher
    draw_progress 100 "🎉 OpenRig Workstation is 100% up and ready!" "true"
    echo -e "\n${GREEN}👉 Terminal: ${BOLD}rig shell${RESET} | Open IDE: ${BOLD}rig ide${RESET} (or run ${BOLD}code .${RESET} / ${BOLD}agy .${RESET} inside OpenRig!)"
}

start_ide_bridge_watcher() {
    local trigger_file="${RIG_DIR}/workspace/.openrig-ide-trigger"
    local cmd_file="${RIG_DIR}/workspace/.openrig-host-cmd"
    local out_file="${RIG_DIR}/workspace/.openrig-host-cmd.out"
    local pid_file="$HOME/.openrig/ide-watcher.pid"
    rm -f "$trigger_file" "$cmd_file" "$out_file"
    if [ -f "$pid_file" ] && kill -0 "$(cat "$pid_file" 2>/dev/null)" 2>/dev/null; then
        return 0
    fi
    (
        while true; do
            if [ -f "$trigger_file" ]; then
                target_path=$(cat "$trigger_file" 2>/dev/null || echo "/workspace")
                rm -f "$trigger_file"
                [ -z "$target_path" ] && target_path="/workspace"
                if [ -x "/Applications/Antigravity IDE.app/Contents/Resources/app/bin/antigravity-ide" ]; then
                    "/Applications/Antigravity IDE.app/Contents/Resources/app/bin/antigravity-ide" --new-window --folder-uri "vscode-remote://ssh-remote+openrig${target_path}" >/dev/null 2>&1 &
                elif command -v cursor >/dev/null 2>&1; then
                    cursor --new-window --folder-uri "vscode-remote://ssh-remote+openrig${target_path}" >/dev/null 2>&1 &
                elif command -v code >/dev/null 2>&1; then
                    code --new-window --folder-uri "vscode-remote://ssh-remote+openrig${target_path}" >/dev/null 2>&1 &
                fi
            fi
            if [ -f "$cmd_file" ]; then
                raw_cmd=$(cat "$cmd_file" 2>/dev/null || true)
                rm -f "$cmd_file"
                case "$raw_cmd" in
                    service\ up\ *)
                        svcs="${raw_cmd#service up }"
                        docker compose -f "${RIG_DIR}/docker-compose.yml" --env-file "$ENV_FILE" up -d $svcs > "${out_file}.tmp" 2>&1 || true
                        mv "${out_file}.tmp" "$out_file"
                        ;;
                    service\ down\ *)
                        svcs="${raw_cmd#service down }"
                        docker compose -f "${RIG_DIR}/docker-compose.yml" --env-file "$ENV_FILE" stop $svcs > "${out_file}.tmp" 2>&1 || true
                        mv "${out_file}.tmp" "$out_file"
                        ;;
                    snapshot\ restore\ *)
                        snap_tag="${raw_cmd#snapshot restore }"
                        role=$(grep -E '^OPENRIG_ROLE=' "$ENV_FILE" | cut -d= -f2 || echo "fullstack")
                        (
                            docker tag "openrig-snapshot:${snap_tag}" "openrig:${role}" && \
                            docker compose -f "${RIG_DIR}/docker-compose.yml" --env-file "$ENV_FILE" up -d --force-recreate
                        ) > "${out_file}.tmp" 2>&1 || true
                        mv "${out_file}.tmp" "$out_file"
                        ;;
                    *)
                        echo "❌ Action not permitted over Host bridge." > "$out_file"
                        ;;
                esac
            fi
            sleep 0.5
        done
    ) </dev/null >/dev/null 2>&1 &
    echo $! > "$pid_file"
    disown 2>/dev/null || true
}

cmd_shell() {
    if ! docker ps --format '{{.Names}}' | grep -q "^openrig$"; then
        cmd_up
    fi
    start_ide_bridge_watcher
    local shell_pref="ohmyzsh"
    if [ -f "$ENV_FILE" ]; then
        shell_pref=$(grep -E '^OPENRIG_SHELL=' "$ENV_FILE" | cut -d= -f2 || echo "ohmyzsh")
    fi
    echo -e "${CYAN}🔌 Connecting to OpenRig terminal (${shell_pref} -> /workspace)...${RESET}"
    case "$shell_pref" in
        fish) docker exec -it openrig fish -l ;;
        bash) docker exec -it openrig bash -l ;;
        *)    docker exec -it openrig zsh -l ;;
    esac
}

cmd_ide() {
    if ! docker ps --format '{{.Names}}' | grep -q "^openrig$"; then
        cmd_up
    fi
    local remote_path="${1:-/workspace}"
    # Ensure conflicting Microsoft Remote-SSH extensions in ~/.antigravity-ide do not override Antigravity's built-in OpenSSH resolver
    rm -rf "$HOME/.antigravity-ide/extensions/ms-vscode-remote."* "$HOME/.antigravity-ide/extensions/ms-vscode.remote-"* 2>/dev/null || true

    if [ -x "/Applications/Antigravity IDE.app/Contents/Resources/app/bin/antigravity-ide" ]; then
        echo -e "${CYAN}🚀 Opening Antigravity IDE connected directly to 'openrig:${remote_path}'...${RESET}"
        "/Applications/Antigravity IDE.app/Contents/Resources/app/bin/antigravity-ide" --folder-uri "vscode-remote://ssh-remote+openrig${remote_path}"
    elif command -v cursor >/dev/null 2>&1; then
        cursor --folder-uri "vscode-remote://ssh-remote+openrig${remote_path}"
    elif command -v code >/dev/null 2>&1; then
        code --folder-uri "vscode-remote://ssh-remote+openrig${remote_path}"
    else
        echo -e "${YELLOW}ℹ️ Use your IDE's 'Remote-SSH: Connect to SSH Host...' -> select 'openrig' -> open '${remote_path}'.${RESET}"
    fi
}

cmd_service() {
    ensure_env
    local sub="${1:-help}"
    shift || true
    case "$sub" in
        up)
            echo -e "${CYAN}🐳 Starting sibling containers alongside OpenRig: $*${RESET}"
            docker compose -f "${RIG_DIR}/docker-compose.yml" --env-file "$ENV_FILE" up -d "$@"
            ;;
        down)
            docker compose -f "${RIG_DIR}/docker-compose.yml" --env-file "$ENV_FILE" stop "$@"
            ;;
        *)
            echo "Usage: ./rig service up [postgres|redis|localstack]"
            echo "       ./rig service down [postgres|redis|localstack]"
            ;;
    esac
}

