ensure_env() {
    if [ ! -f "$ENV_FILE" ]; then
        echo -e "${YELLOW}ℹ️ No se encontró configuración previa (.env). Iniciando asistente...${RESET}"
        cmd_setup
    fi
}

MAX_PCT=0
LAST_STAGE=""
draw_progress() {
    local pct="$1"
    local msg="$2"
    local is_milestone="${3:-false}"
    if [ "$pct" -lt "$MAX_PCT" ]; then
        pct="$MAX_PCT"
    else
        MAX_PCT="$pct"
    fi
    local width=28
    local filled=$(( pct * width / 100 ))
    local empty=$(( width - filled ))
    local bar=""
    for ((i=0; i<filled; i++)); do bar+="█"; done
    for ((i=0; i<empty; i++)); do bar+="░"; done

    if [ "$is_milestone" = "true" ] && [ "$msg" != "$LAST_STAGE" ]; then
        printf "\r\033[K${GREEN}✔${RESET} ${CYAN}[%s] ${BOLD}%3d%%${RESET} — %s\n" "$bar" "$pct" "$msg"
        LAST_STAGE="$msg"
    else
        printf "\r\033[K${CYAN}[%s] ${BOLD}%3d%%${RESET} — %s" "$bar" "$pct" "$msg"
    fi
}

cmd_up() {
    ensure_env
    local role
    role=$(grep -E '^OPENRIG_ROLE=' "$ENV_FILE" | cut -d= -f2 || echo "fullstack")
    local image_name="openrig:${role}"
    local build_log="/tmp/openrig-build.log"
    local no_cache_flag=""
    if [[ "${1:-}" == "--no-cache" ]]; then
        no_cache_flag="--no-cache"
        shift || true
    fi

    echo -e "${CYAN}${BOLD}🚀 Preparando estación OpenRig (Perfil: ${role})...${RESET}"
    draw_progress 5 "Verificando motor de contenedores (Docker / OrbStack)..." "true"

    if ! docker image inspect "$image_name" >/dev/null 2>&1 || [[ -n "$no_cache_flag" ]] || [[ "${1:-}" == "--rebuild" ]]; then
        [[ "${1:-}" == "--rebuild" ]] && shift || true
        echo -e "${YELLOW}📦 Construyendo imagen modular '${image_name}' (Log detallado en ${build_log})...${RESET}"
        draw_progress 8 "📥 [0/7] Preparando imagen base Ubuntu 24.04 LTS..." "true"

        set +e
        docker compose -f "${RIG_DIR}/docker-compose.yml" --env-file "$ENV_FILE" build $no_cache_flag --progress=plain 2>&1 | tee "$build_log" | while IFS= read -r line; do
            if [[ "$line" == *"Installing Base Workstation"* ]]; then
                draw_progress 12 "🧱 [1/7] Instalando Sistema Base (Ubuntu + Oh My Zsh + Docker CLI)..." "true"
            elif [[ "$line" == *"Installing Docker CLI"* ]]; then
                draw_progress 18 "🐳 [1/7] Configurando Docker CLI para Contenedores Hermanos..." "true"
            elif [[ "$line" == *"Base system ready"* ]]; then
                draw_progress 22 "✅ [1/7] Sistema Base completado." "true"
            elif [[ "$line" == *"Installing Python Module"* ]]; then
                draw_progress 26 "🐍 [2/7] Instalando Python (uv + pyenv + Python 3.12)..." "true"
            elif [[ "$line" == *"Installed 1 executable: django-admin"* ]]; then
                draw_progress 34 "🐍 [2/7] Frameworks Python listos (Django, Flask, FastAPI, Ruff, Pytest)..." "true"
            elif [[ "$line" == *"Installing JVM Module"* ]]; then
                draw_progress 40 "☕ [3/7] Instalando JVM vía SDKMAN! (Java 21 LTS)..." "true"
            elif [[ "$line" == *"Installing: kotlin"* ]]; then
                draw_progress 46 "☕ [3/7] Instalando Kotlin y Spring Boot CLI..." "true"
            elif [[ "$line" == *"Installing: gradle"* ]]; then
                draw_progress 52 "☕ [3/7] Instalando Apache Maven y Gradle..." "true"
            elif [[ "$line" == *"Installing Node & Frontend"* ]]; then
                draw_progress 58 "🎨 [4/7] Instalando Node.js vía NVM + Vue.js + React + Vite..." "true"
            elif [[ "$line" == *"Node & Frontend module installed"* ]]; then
                draw_progress 66 "✅ [4/7] Entorno Frontend & Node.js completado." "true"
            elif [[ "$line" == *"Installing Mobile"* ]]; then
                draw_progress 68 "📱 [4b/7] Instalando Mobile (Flutter + Android SDK CLI + ADB)..." "true"
            elif [[ "$line" == *"Installing Cloud"* ]]; then
                draw_progress 72 "☁️  [5/7] Instalando Cloud & DBs (AWS CLI v2 + kubectl + Postgres/Redis)..." "true"
            elif [[ "$line" == *"Installing Security"* ]]; then
                draw_progress 80 "🛡️  [6/7] Instalando Suite de Seguridad (Trivy, Semgrep, Nuclei, Nmap, Gitleaks)..." "true"
            elif [[ "$line" == *"Security & Pentesting module installed"* ]]; then
                draw_progress 87 "✅ [6/7] Suite de Seguridad y Pentesting lista." "true"
            elif [[ "$line" == *"Installing AI Coding"* ]]; then
                draw_progress 90 "🤖 [7/7] Instalando Agentes de IA en Sandbox (Claude, Gemini, Codex, Aider)..." "true"
            elif [[ "$line" == *"exporting to image"* ]]; then
                draw_progress 95 "💾 Empaquetando capas de la imagen en disco..." "true"
            elif [[ "$line" == *"unpacking to"* ]]; then
                draw_progress 98 "📂 Desempaquetando imagen final..." "true"
            fi
        done
        local build_rc="${PIPESTATUS[0]}"
        set -e
        if [ "$build_rc" -ne 0 ]; then
            echo ""
            echo -e "${RED}❌ Error durante la construcción. Revisa las últimas líneas de ${build_log}:${RESET}"
            tail -n 25 "$build_log"
            exit "$build_rc"
        fi
    else
        draw_progress 60 "⚡ Imagen '${image_name}' detectada en caché local..." "true"
    fi

    draw_progress 99 "🔌 Levantando red 'openrig-net', volúmenes de caché y puente SSH..." "true"
    docker compose -f "${RIG_DIR}/docker-compose.yml" --env-file "$ENV_FILE" up -d "$@" >/dev/null 2>&1
    # Sync ONLY safe public SSH files (*.pub, known_hosts, allowed_signers) — never mount or copy private keys
    docker exec openrig mkdir -p /home/rig/.ssh >/dev/null 2>&1 || true
    for pub_file in "$HOME/.ssh/"*.pub "$HOME/.ssh/known_hosts" "$HOME/.ssh/allowed_signers"; do
        [ -f "$pub_file" ] && docker cp "$pub_file" "openrig:/home/rig/.ssh/" >/dev/null 2>&1 || true
    done
    docker exec -u root openrig bash -c "chown -R rig:rig /home/rig/.ssh && chmod 700 /home/rig/.ssh" >/dev/null 2>&1 || true
    draw_progress 100 "🎉 ¡Estación OpenRig 100% activa y lista!" "true"
    echo -e "\n${GREEN}👉 Entra a tu estación ejecutando: ${BOLD}rig shell${RESET} (o ${BOLD}./rig shell${RESET})"
}

cmd_shell() {
    if ! docker ps --format '{{.Names}}' | grep -q "^openrig$"; then
        cmd_up
    fi
    local shell_pref="ohmyzsh"
    if [ -f "$ENV_FILE" ]; then
        shell_pref=$(grep -E '^OPENRIG_SHELL=' "$ENV_FILE" | cut -d= -f2 || echo "ohmyzsh")
    fi
    echo -e "${CYAN}🔌 Conectando a la terminal de OpenRig (${shell_pref} -> /workspace)...${RESET}"
    case "$shell_pref" in
        fish) docker exec -it openrig fish -l ;;
        bash) docker exec -it openrig bash -l ;;
        *)    docker exec -it openrig zsh -l ;;
    esac
}

cmd_service() {
    ensure_env
    local sub="${1:-help}"
    shift || true
    case "$sub" in
        up)
            echo -e "${CYAN}🐳 Levantando contenedores hermanos al lado de OpenRig: $*${RESET}"
            docker compose -f "${RIG_DIR}/docker-compose.yml" --env-file "$ENV_FILE" up -d "$@"
            ;;
        down)
            docker compose -f "${RIG_DIR}/docker-compose.yml" --env-file "$ENV_FILE" stop "$@"
            ;;
        *)
            echo "Uso: ./rig service up [postgres|redis|localstack]"
            echo "     ./rig service down [postgres|redis|localstack]"
            ;;
    esac
}

