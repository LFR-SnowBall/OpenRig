# ==============================================================================
# OpenRig — Portable Modular Dev & Sec Workstation Configuration
# Generated by: ./rig setup (macOS/Linux) or .\rig.ps1 setup (Windows)
# ==============================================================================

# Selected Role Profile (custom | backend-python | backend-jvm | frontend | mobile | devops | sec | fullstack)
OPENRIG_ROLE=fullstack

# --- Language & Tooling Modules (true / false) ---
INSTALL_PYTHON=true
INSTALL_JVM=true
INSTALL_NODE=true
INSTALL_MOBILE=false
INSTALL_SWIFT=false
INSTALL_CLOUD=true
INSTALL_SEC=true
INSTALL_AI=true

# --- Default Language Versions ---
PYTHON_DEFAULT_VERSION=3.12
NODE_DEFAULT_VERSION=22
JAVA_DEFAULT_VERSION=21.0.5-tem

# --- Host & Network Settings ---
CONTAINER_NAME=openrig
HOST_WORKSPACE_PATH=./workspace
SSH_MODE=auto

# ==============================================================================
# 🎛️ Modular Feature & Security Policy Flags (Zero-Force Modular Sovereignty)
# Each user or enterprise toggles exactly what to activate or block (true / false)
# ==============================================================================
OPENRIG_ENABLE_WEB_IDE=true        # Set to false to disable VS Code Web engine completely
OPENRIG_ALLOW_MOBILE=false         # Set to true to allow quick mobile SSH access without HW UUID lock
OPENRIG_ALLOW_ADMIN_ATTACH=true    # Set to false to reject server host admin live pairing attach
OPENRIG_ENABLE_SHARE=true          # Set to false to block cloudflared public HTTPS demo tunnels
