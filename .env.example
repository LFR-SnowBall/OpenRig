# ==============================================================================
# OpenRig — Portable Modular Dev & Sec Workstation Configuration
# Generated by: ./rig setup (macOS/Linux) or .\rig.ps1 setup (Windows)
# ==============================================================================

# Selected Role Profile (custom | backend-python | backend-jvm | frontend | mobile | devops | sec | fullstack)
OPENRIG_ROLE=fullstack

# --- Language & Tooling Modules (true / false) ---
INSTALL_PYTHON=true
INSTALL_JVM=true
INSTALL_NODE=true
INSTALL_MOBILE=false
INSTALL_SWIFT=false
INSTALL_CLOUD=true
INSTALL_SEC=true
INSTALL_AI=true

# --- Default Language Versions ---
PYTHON_DEFAULT_VERSION=3.12
NODE_DEFAULT_VERSION=22
JAVA_DEFAULT_VERSION=21.0.5-tem

# --- Host & Network Settings ---
CONTAINER_NAME=openrig
HOST_WORKSPACE_PATH=./workspace
SSH_MODE=auto
